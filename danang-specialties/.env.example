# Public site URL used for product links in Facebook posts (must be public HTTPS for photo posting).
# Example production: https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Facebook Page publishing (optional — enables one-click "Post to Page" in admin)
# Page ID defaults to Đặc Sản Đà Nẵng Duy Nhân (100057455118487)
FACEBOOK_PAGE_ID=100057455118487
# Long-lived Page access token with pages_manage_posts + pages_read_engagement
FACEBOOK_PAGE_ACCESS_TOKEN=

# Duy Nhân admin (optional overrides)
ADMIN_PASSWORD=duynhan2026
ADMIN_SESSION_SECRET=duynhan-admin-session-change-me
